{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.4-mini",
  "default_agent": "octto",
  "plugin": [
    "opencode-skill-creator",         // agent that helps to create skills
    "opencode-plugin-openspec",       // openspec for spec-driven development
    "@tarquinen/opencode-dcp@latest", // dynamic context pruning
    "opencode-vibeguard",             // data protection by replacing potential critical data
    "octto",
    "opencode-token-monitor@latest",    
  ],
  "command": {
    "commit": {
      "template": "Commit all changes, made in this session. Use @ConventionalCommitWriter to create the commit message. DO NOT commit into a default branch.",
      "description": "commits changes of session"
    },
    "adr": {
      "template": "compress all decissions of this session into an ADR-document. Link the document to the original task if it was started from a task. Mark the task as complete and link to the created ADR-document.",
      "description": "compress and create adr"
    }
  },
  "agent": {
    "octto": {
      "model": "openai/gpt-5.6-terra",
    }
  },
  "permission": {
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "bin/**",
      "build/**",
      ".gocache/**",
      "*/**.db",
      "**/config.json",
      "docs/archive/**",
    ]
  },
  "experimental": {
    "openTelemetry": false,
  }
}